5;223m.\u001b[38;5;221m~~\u001b[38;5;130m.\u001b[0m       \u001b[38;5;137m│\u001b[0m\u001b[11;125H\u001b[38;5;137m│\u001b[0m   \u001b[38;5;130m(\u001b[38;5;221m  \u001b[38;5;230m.---.\u001b[38;5;221m   \u001b[38;5;230m.---.\u001b[38;5;221m  \u001b[38;5;130m)\u001b[0m        \u001b[38;5;137m│\u001b[0m\u001b[12;125H\u001b[38;5;137m│\u001b[0m   \u001b[38;5;130m(\u001b[38;5;221m \u001b[38;5;230m( \u001b[38;5;52m●\u001b[38;5;230m )\u001b[38;5;221m \u001b[38;5;230m( \u001b[38;5;52m●\u001b[38;5;230m )\u001b[38;5;221m \u001b[38;5;130m)\u001b[0m            \u001b[38;5;137m│\u001b[0m\u001b[13;125H\u001b[38;5;137m│\u001b[0m   \u001b[38;5;130m(\u001b[38;5;221m  \u001b[38;5;230m'---'\u001b[38;5;221m   \u001b[38;5;230m'---'\u001b[38;5;221m  \u001b[38;5;130m)\u001b[0m        \u001b[38;5;137m│\u001b[0m\u001b[14;125H\u001b[38;5;137m│\u001b[0m   \u001b[38;5;130m(\u001b[38;5;221m \u001b[38;5;174mo\u001b[38;5;221m  \u001b[38;5;223m*\u001b[38;5;221m       \u001b[38;5;174mo\u001b[38;5;221m  \u001b[38;5;130m)\u001b[0m          \u001b[38;5;137m│\u001b[0m\u001b[15;125H\u001b[38;5;137m│\u001b[0m   \u001b[38;5;130m(\u001b[38;5;221m    \u001b[38;5;130m\\\u001b[38;5;221m         \u001b[38;5;130m/\u001b[38;5;221m    \u001b[38;5;130m)\u001b[0m      \u001b[38;5;137m│\u001b[0m\u001b[16;125H\u001b[38;5;137m│\u001b[0m    \u001b[38;5;130m'\u001b[38;5;221m~~~\u001b[38;5;130m\\\u001b[38;5;255m_\u001b[38;5;130m|\u001b[38;5;255m_\u001b[38;5;130m/\u001b[38;5;221m~~~~~\u001b[38;5;130m'\u001b[0m           \u001b[38;5;137m│\u001b[0m\u001b[17;125H\u001b[38;5;137m│\u001b[0m      \u001b[38;5;130m'~\u001b[38;5;221m~~~~~~~~~\u001b[38;5;130m~'\u001b[0m           \u001b[38;5;137m│\u001b[0m\u001b[18;125H\u001b[38;5;137m│\u001b[0m                              \u001b[38;5;137m│\u001b[0m\u001b[19;125H\u001b[38;5;137m│\u001b[0m        \u001b[1m\u001b[38;5;215m~ Crumb ~\u001b[0m             \u001b[38;5;137m│\u001b[0m\u001b[20;125H\u001b[38;5;137m│\u001b[0m      \u001b[2m\u001b[38;5;244myour tiny agent\u001b[0m         \u0