lines.push(`${body[8]}  ${friendR}`);',\u001b[0m                                                                     \u001b[25;2H\u001b[K    \u001b[38;5;108m    '    lines.push(`${body[8]} ${friendR}`);'\u001b[0m                                                                       \u001b[26;2H\u001b[K    \u001b[38;5;108m)"]
